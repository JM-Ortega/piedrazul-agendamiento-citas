# Stack de observabilidad (piedrazul-obs). Copiar a .env en este directorio (ignorado por git).
# En un host instalado por Ansible (playbooks/observability.yml) .env lo genera el rol
# observability la primera vez, con una contraseña aleatoria que no vuelve a escribir.

# Administrador local de Grafana. Grafana la aplica solo al crear su base (volumen
# grafana_data); cambiarla después: docs/operations/runbooks/metricas.md
GRAFANA_ADMIN_PASSWORD=

# Red Docker de la aplicación (debe existir antes de `up`). Por defecto piedrazul_net.
# OBS_APP_NETWORK=piedrazul_net

# Puerto de Grafana en 127.0.0.1 del host (nunca en una interfaz pública). Por defecto 3000.
# GRAFANA_LOCAL_PORT=3000

# Retención de Prometheus: se aplica lo que se cumpla primero. Por defecto 30d y 2GB. El tamaño
# no es un tope duro del volumen (WAL y compactación lo pueden superar).
# PROMETHEUS_RETENTION_TIME=30d
# PROMETHEUS_RETENTION_SIZE=2GB

# Logs (docs/operations/runbooks/logs.md). En un host instalado por Ansible estas variables las
# mantiene el rol observability en .env.
#
# GID del grupo dueño de los archivos del journal del host (en Ubuntu, systemd-journal:
# `stat -c %g /var/log/journal/$(cat /etc/machine-id)`). Por defecto 65534: Alloy no lee el
# journal y el resto del stack funciona igual.
# OBS_JOURNAL_GID=65534
#
# Fuentes enviadas a Loki: proyecto Compose de la aplicación y servicios (expresión regular,
# alternativas con |). Solo servicios que escriben en el journal (logging.driver: journald) y que
# la política de fuentes admite; backend y keycloak requieren antes sus controles de privacidad.
# OBS_LOG_PROJECT=piedrazul
# OBS_LOG_SERVICES=traefik

# ── Acceso a Grafana por Cloudflare Access (docs/operations/runbooks/grafana-acceso.md) ──
# En un host instalado por Ansible estas variables son el estado deseado persistente que mantiene
# el rol observability (obs_grafana_access_*, "Estado deseado" en el runbook). Sin ellas (por
# defecto) Grafana solo se usa por túnel SSH (modo privado).
#
# Archivos de Compose: modo privado solo compose.yml; con el acceso público además
# compose.access.yml (Grafana en la red de entrada de Traefik).
# COMPOSE_FILE=compose.yml:compose.access.yml
#
# Red interna compartida con Traefik (la crea infra/compose/traefik.yml); solo la usa
# compose.access.yml y debe existir antes de `up` en ese modo. Por defecto piedrazul_obs_edge.
# OBS_EDGE_NETWORK=piedrazul_obs_edge
#
# Nombre público guardado (el rol deriva de él GRAFANA_ROOT_URL cuando el acceso está habilitado)
# GRAFANA_PUBLIC_DOMAIN=grafana.piedrazul.org
#
# URL pública con la que Grafana arma enlaces y redirecciones. Con Access:
# https://grafana.<dominio>/. Por defecto http://localhost:${GRAFANA_LOCAL_PORT}/.
# GRAFANA_ROOT_URL=https://grafana.piedrazul.org/
#
# true: Grafana acepta el JWT de Access (cabecera Cf-Access-Jwt-Assertion). Requiere las tres
# siguientes; con cualquiera vacía o incorrecta, ningún JWT se acepta (falla cerrado).
# GRAFANA_ACCESS_ENABLED=false
# Dominio del equipo de Zero Trust (emisor y JWKS): <equipo>.cloudflareaccess.com
# (piedrazul.cloudflareaccess.com según lo preparado por el operador; confirmarlo)
# GRAFANA_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) Tag de la aplicación de Access de Grafana (64 hex)
# GRAFANA_ACCESS_AUD=
# Autorización en Grafana (además de la política de Access): correos en minúsculas separados por
# comas, sin espacios. Editor: edita dashboards. Viewer: solo lectura. Fuera de ambas: 403.
# Nunca Admin por esta vía: la administración es del administrador local (túnel).
# GRAFANA_ACCESS_EDITORS=
# GRAFANA_ACCESS_VIEWERS=

# ── Notificaciones (docs/operations/runbooks/alertas.md) ──
# Receptor de Alertmanager: none (no envía; por defecto) o discord.
# OBS_ALERT_RECEIVER=none
# Entorno de origen que encabeza cada mensaje (etiqueta externa environment de Prometheus):
# obligatorio con discord, porque staging y producción pueden compartir el webhook.
# OBS_ENVIRONMENT=staging
# Archivo del host con la URL del webhook de Discord (secreto: nunca en este .env ni en git).
# Debe existir aunque el receptor sea none (vacío) y ser legible solo por el UID 65534
# (Alertmanager). Por defecto ./secrets/discord_webhook_url, con secrets/ en 0700.
# OBS_DISCORD_WEBHOOK_FILE=./secrets/discord_webhook_url
