    {
      "type": "stat",
      "title": "Tiempo en ejecución",
      "description": "Tiempo desde el último arranque de la JVM del backend. Un valor bajo inesperado indica un reinicio (despliegue, caída o falta de memoria): conviene revisar los logs del backend.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "process_uptime_seconds{job=\"backend\"}",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true
