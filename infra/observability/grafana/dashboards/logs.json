    {
      "type": "timeseries",
      "title": "Reintentos, rechazos y descartes",
      "description": "Solo los resultados problemáticos del envío, por segundo. En naranja, reintentos de Alloy y respuestas de error de Loki por código: Alloy reintenta los 429 (límite de tasa) y los 5xx, que pueden terminar bien o acabar descartados; otros 4xx no se reintentan y esas entradas se pierden. En rojo, muestras que Loki rechazó y entradas que Alloy descartó, por motivo: pérdida. Lo normal son líneas en 0. Los envíos correctos están en Flujo de entradas.",
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 45
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(loki_write_batch_retries_total{job=\"alloy\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "reintentos de Alloy",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status_code) (rate(loki_write_request_duration_seconds_count{job=\"alloy\", status_code!~\"2..\"}[$__rate_interval]))",
          "refId": "B",
          "legendFormat": "respuestas con error {{status_code}}",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (reason) (rate(loki_discarded_samples_total{job=\"loki\"}[$__rate_interval]))",
          "refId": "C",
          "legendFormat": "rechazadas por Loki: {{reason}}",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (reason) (rate(loki_write_dropped_entries_total{job=\"alloy\"}[$__rate_interval]))",
          "refId": "D",
          "legendFormat": "descartadas por Alloy: {{reason}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
