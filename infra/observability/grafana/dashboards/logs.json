    {
      "type": "stat",
      "title": "Alertas de logs disparadas",
      "description": "Alertas de la canalización de logs (grupo de reglas piedrazul-logs: Loki sin leer, componentes de Alloy, journal sin leer, descartes y retención) en estado firing. 0 en verde solo si Prometheus evaluó ese grupo en los últimos 2 min; si no, SIN DATOS (morado): estado desconocido, no sano. También cuentan en Alertas que requieren atención de Plataforma.",
      "id": 18,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(ALERTS{alertstate=\"firing\", alertname=~\"PiedrazulLoki.*|PiedrazulLogs.*|PiedrazulAlloyComponentUnhealthy\"}) or on() (0 * (max(time() - prometheus_rule_group_last_evaluation_timestamp_seconds{job=\"prometheus\", rule_group=~\".+/logs.yml;piedrazul-logs\"}) < 120))",
          "refId": "A",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "SIN DATOS",
                  "color": "purple",
                  "index": 9
                }
              }
            }
          ],
