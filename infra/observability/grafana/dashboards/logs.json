            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "logs",
      "title": "Logs",
      "description": "Vista general: líneas de los servicios seleccionados, la más reciente primero, con el servicio y la severidad de cada línea. Filtros: servicio, severidad (Todas incluye las líneas sin severidad), id de correlación (vacío: sin filtrar) y búsqueda (expresión regular, sin distinguir mayúsculas). El detalle de cada línea muestra sus etiquetas, container_id y, en el backend, correlation_id.",
      "id": 4,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=~\"$service\", level=~\"$level\"} |= \"$correlation_id\" |~ \"(?i)$search\"",
          "refId": "A",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "type": "row",
      "title": "Investigación por id de correlación",
      "id": 5,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "panels": []
    },
    {
      "type": "logs",
      "title": "Líneas con el id de correlación (todos los servicios)",
      "description": "Con un id en la variable Id de correlación (UUID de la cabecera X-Correlation-Id): todas las líneas que lo contienen, de cualquier servicio y severidad, sin los demás filtros. Sin id no muestra nada (la vista general es el panel Logs). Que un servicio no muestre el id no prueba que no participó: solo el backend lo escribe en sus líneas.",
      "id": 6,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=~\".+\"} |= \"$correlation_id\" | label_format correlation_query=`$correlation_id` | correlation_query != \"\" | drop correlation_query",
          "refId": "A",
          "queryType": "range",
          "editorMode": "code"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
