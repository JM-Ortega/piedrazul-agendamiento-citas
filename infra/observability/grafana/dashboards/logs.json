        "y": 40
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(loki_write_batch_retries_total{job=\"alloy\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "reintentos de Alloy",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status_code) (rate(loki_write_request_duration_seconds_count{job=\"alloy\"}[$__rate_interval]))",
          "refId": "B",
          "legendFormat": "respuestas {{status_code}}",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (reason) (rate(loki_discarded_samples_total{job=\"loki\"}[$__rate_interval]))",
          "refId": "C",
          "legendFormat": "rechazadas por Loki: {{reason}}",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (reason) (rate(loki_write_dropped_entries_total{job=\"alloy\"}[$__rate_interval]))",
          "refId": "D",
          "legendFormat": "descartadas por Alloy: {{reason}}",
          "range": true,
          "instant": false
        }
