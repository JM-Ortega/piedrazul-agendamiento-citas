      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Líneas por servicio",
      "description": "Líneas recibidas en Loki por servicio con los filtros del dashboard. Un servicio sin líneas puede estar simplemente callado: la salud de la recolección está en la última fila.",
      "id": 2,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (service) (count_over_time({service=~\"$service\", level=~\"$level\"} |= \"$correlation_id\" |~ \"(?i)$search\" [$__auto]))",
          "refId": "A",
          "queryType": "range",
          "editorMode": "code",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Errores y avisos por servicio",
      "description": "Líneas con severidad error, fatal o warn. La severidad solo existe donde el formato del servicio la expone (backend, Keycloak, Traefik); las líneas sin ella (continuaciones de trazas) no cuentan aquí.",
      "id": 3,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (service, level) (count_over_time({service=~\"$service\", level=~\"error|fatal|warn\"} [$__auto]))",
          "refId": "A",
          "queryType": "range",
          "editorMode": "code",
          "legendFormat": "{{service}} {{level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
