# Generado por Ansible — no editar manualmente

# Identidad del proyecto
PROJECT_NAME={{ compose_project_name }}
GITHUB_OWNER=jm-ortega
GITHUB_REPO=piedrazul-agendamiento-citas

# Spring / backend
SPRING_PROFILES_ACTIVE={{ spring_profiles_active }}
SERVER_PORT={{ server_port }}
SERVER_FORWARD_HEADERS_STRATEGY={{ server_forward_headers_strategy }}
APP_TIMEZONE={{ app_timezone }}

# Base de datos app
DB_HOST={{ db_host }}
DB_PORT={{ db_port }}
DB_NAME={{ db_name }}
DB_USER={{ db_user }}
DB_PASSWORD={{ lookup('env', 'DB_PASSWORD') }}
DB_SCHEMA={{ db_schema }}

# JPA / Hibernate
JPA_DDL_AUTO={{ jpa_ddl_auto }}
JPA_SHOW_SQL={{ jpa_show_sql | lower }}
JPA_FORMAT_SQL={{ jpa_format_sql | lower }}

# Errores
ERROR_INCLUDE_STACKTRACE={{ error_include_stacktrace }}
ERROR_INCLUDE_MESSAGE={{ error_include_message }}

# Uploads
MAX_FILE_SIZE={{ max_file_size }}
MAX_REQUEST_SIZE={{ max_request_size }}

# Actuator
MANAGEMENT_EXPOSED_ENDPOINTS={{ management_exposed_endpoints }}
MANAGEMENT_HEALTH_DETAILS={{ management_health_details }}

# Logging
LOG_LEVEL_ROOT={{ log_level_root }}
LOG_LEVEL_SECURITY={{ log_level_security }}
LOG_LEVEL_SQL={{ log_level_sql }}
LOG_LEVEL_SQL_BIND={{ log_level_sql_bind }}

# CORS
CORS_ALLOWED_ORIGINS={{ cors_allowed_origins }}

# Keycloak DB
KC_DB_USERNAME={{ kc_db_username }}
KC_DB_SCHEMA={{ kc_db_schema }}
KC_DB_PASSWORD={{ lookup('env', 'KC_DB_PASSWORD') }}

# Keycloak bootstrap
KC_BOOTSTRAP_ADMIN_USERNAME={{ kc_bootstrap_admin_user }}
KC_BOOTSTRAP_ADMIN_PASSWORD={{ lookup('env', 'KC_BOOTSTRAP_ADMIN_PASSWORD') }}

# Keycloak admin permanente
KC_ADMIN_USER={{ kc_admin_user }}
KC_ADMIN_PASSWORD={{ lookup('env', 'KC_ADMIN_PASSWORD') }}

# Keycloak config
KC_PORT={{ kc_port }}
KC_REALM={{ kc_realm }}
KC_HOSTNAME={{ kc_hostname }}
KC_SERVER_URL=http://keycloak:{{ kc_port }}
KC_ISSUER_URI=https://{{ kc_hostname }}/realms/{{ kc_realm }}
KC_HEALTH_ENABLED={{ kc_health_enabled | lower }}
KC_METRICS_ENABLED={{ kc_metrics_enabled | lower }}

# Keycloak cliente backend
KC_BACKEND_CLIENT_ID={{ kc_backend_client_id }}
KC_BACKEND_CLIENT_SECRET={{ app_kc_backend_secret }}

# Dominios
API_PUBLIC_DOMAIN={{ api_public_domain }}

# Let's Encrypt
ACME_EMAIL={{ acme_email }}

# Cloudflare
CLOUDFLARE_DNS_API_TOKEN={{ lookup('env', 'CLOUDFLARE_DNS_API_TOKEN') }}

# Identity seed
IDENTITY_SEED_ENABLED={{ lookup('env', 'IDENTITY_SEED_ENABLED') | lower }}
IDENTITY_SEED_ADMIN_USERNAME={{ lookup('env', 'IDENTITY_SEED_ADMIN_USERNAME') }}
IDENTITY_SEED_ADMIN_FIRST_NAME={{ lookup('env', 'IDENTITY_SEED_ADMIN_FIRST_NAME') }}
IDENTITY_SEED_ADMIN_LAST_NAME={{ lookup('env', 'IDENTITY_SEED_ADMIN_LAST_NAME') }}
IDENTITY_SEED_ADMIN_EMAIL={{ lookup('env', 'IDENTITY_SEED_ADMIN_EMAIL') }}
IDENTITY_SEED_ADMIN_PASSWORD={{ lookup('env', 'IDENTITY_SEED_ADMIN_PASSWORD') }}

# Notificaciones
NOTIFICATION_ENCRYPTION_KEY={{ lookup('env', 'NOTIFICATION_ENCRYPTION_KEY') }}
NOTIFICATIONS_SENDGRID_ENABLED={{ notifications_sendgrid_enabled | lower }}
SENDGRID_API_KEY={{ lookup('env', 'PIEDRAZUL_BACKEND_MAIL_SEND') }}
SENDGRID_SANDBOX_MODE={{ notifications_sendgrid_sandbox_mode | lower }}
NOTIFICATIONS_EMAIL_FROM={{ notifications_email_from }}
NOTIFICATIONS_EMAIL_FROM_NAME={{ notifications_email_from_name }}
