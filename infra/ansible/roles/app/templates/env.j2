# Generado por Ansible — no editar manualmente

# Identidad del proyecto
PROJECT_NAME={{ compose_project_name }}
GITHUB_OWNER=jm-ortega
GITHUB_REPO=piedrazul-agendamiento-citas

# Base de datos
DB_NAME=piedrazul_db
DB_USER=piedrazul
DB_PASSWORD={{ lookup('env', 'DB_PASSWORD') }}
DB_SCHEMA=piedrazul

# Keycloak DB
KC_DB_USERNAME=keycloak_user
KC_DB_SCHEMA=keycloak
KC_DB_PASSWORD={{ lookup('env', 'KC_DB_PASSWORD') }}

# Keycloak bootstrap (solo primer arranque, Keycloak lo lee directamente)
KC_BOOTSTRAP_ADMIN_USERNAME={{ kc_bootstrap_admin_user }}
KC_BOOTSTRAP_ADMIN_PASSWORD={{ lookup('env', 'KC_BOOTSTRAP_ADMIN_PASSWORD') }}

# Keycloak admin permanente (gestionado por Ansible tras init)
KC_ADMIN_USER={{ kc_admin_user }}
KC_ADMIN_PASSWORD={{ lookup('env', 'KC_ADMIN_PASSWORD') }}

# Keycloak config
KC_PORT={{ kc_port }}
KC_REALM={{ kc_realm }}
KC_HOSTNAME={{ kc_hostname }}

# Keycloak cliente backend
KC_BACKEND_CLIENT_ID={{ kc_backend_client_id }}
KC_BACKEND_CLIENT_SECRET={{ app_kc_backend_secret }}

# Dominios
API_PUBLIC_DOMAIN={{ api_public_domain }}

# Let's Encrypt
ACME_EMAIL={{ acme_email }}

# Cloudflare
CLOUDFLARE_DNS_API_TOKEN={{ lookup('env', 'CLOUDFLARE_DNS_API_TOKEN') }}
