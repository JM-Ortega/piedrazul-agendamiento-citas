# Generado por Ansible (app/tasks/traefik_routes.yml) desde el inventario: no editar en el
# servidor. Traefik lo lee con el file provider (watch) junto a tls.yml.
#
# Los servicios apuntan al nombre del contenedor en piedrazul_net; Traefik lo resuelve en
# cada conexión nueva, así que recrear backend o keycloak no deja rutas obsoletas. Mientras
# un upstream no existe o no responde, su router devuelve 502/503 (no 404).
#
# grafana (solo con grafana_public_domain): Grafana del stack de observabilidad, por la red
# interna piedrazul_obs_edge, detrás de Cloudflare Access. La autenticación la hace Grafana con el
# JWT de Access; aquí se cierra todo lo demás: sin /login (contraseña local) y sin las cabeceras
# Authorization (Basic, tokens) ni Cookie (sesiones locales). Ver
# docs/operations/runbooks/grafana-acceso.md.
http:
  routers:
    backend:
      rule: "Host(`{{ api_public_domain }}`)"
      entryPoints:
        - websecure
      service: backend
      tls:
        certResolver: letsencrypt
        options: cloudflare-aop
    keycloak:
      rule: "Host(`{{ kc_hostname }}`)"
      entryPoints:
        - websecure
      service: keycloak
      tls:
        certResolver: letsencrypt
        options: cloudflare-aop
{% if grafana_public_domain | default('') | length > 0 %}
    grafana:
      rule: "Host(`{{ grafana_public_domain }}`) && !PathPrefix(`/login`)"
      entryPoints:
        - websecure
      service: grafana
      middlewares:
        - grafana-access-only
      tls:
        certResolver: letsencrypt
        options: cloudflare-aop
  middlewares:
    grafana-access-only:
      headers:
        customRequestHeaders:
          Authorization: ""
          Cookie: ""
{% endif %}
  services:
    backend:
      loadBalancer:
        servers:
          - url: "http://backend:{{ server_port }}"
    keycloak:
      loadBalancer:
        servers:
          - url: "http://keycloak:{{ kc_port }}"
{% if grafana_public_domain | default('') | length > 0 %}
    grafana:
      loadBalancer:
        servers:
          - url: "http://grafana:3000"
{% endif %}
