# Aplica a todas las rutas
/*
  # Fuerza HTTPS por 1 año, incluye subdominios.
  # Sin 'preload' aún — requiere verificar que todos los subdominios
  # estén estables antes de entrar a la lista HSTS preload (irreversible).
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # Headers temporalmente deshabilitados mientras se estabiliza:
  # - Keycloak silent SSO
  # - Angular 19 + Beasties
  # - Configuración CSP
  # - Compatibilidad iframe/auth en producción
  #
  # Se retomarán progresivamente usando primero:
  # Content-Security-Policy-Report-Only
  #
  # Evita MIME type sniffing
  # X-Content-Type-Options: nosniff
  #
  # Protección contra clickjacking
  # frame-ancestors 'none' en CSP cubre browsers modernos
  # X-Frame-Options: DENY
  #
  # Control de referrer cross-origin
  # Referrer-Policy: strict-origin-when-cross-origin
  #
  # Restricción de APIs del navegador no utilizadas
  # Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  #
  # Content Security Policy
  #
  # default-src 'self'
  # script-src 'self'
  # style-src 'self' 'unsafe-inline' https://fonts.googleapis.com
  # font-src 'self' https://fonts.gstatic.com
  # img-src 'self' data:
  # connect-src 'self' https://api.piedrazul.org https://auth.piedrazul.org
  # frame-src 'self' https://auth.piedrazul.org
  # frame-ancestors 'none'
  # object-src 'none'
  # base-uri 'self'
  # form-action 'self'
  # upgrade-insecure-requests
  #
  # Content-Security-Policy: ...
