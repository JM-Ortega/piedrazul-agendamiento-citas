# Aplica a todas las rutas
/*
  # Fuerza HTTPS por 1 año, incluye subdominios
  # Sin 'preload' aún — requiere verificar que todos los subdominios
  # estén estables antes de entrar a la lista HSTS preload (irreversible)
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # Evita MIME type sniffing
  X-Content-Type-Options: nosniff

  # Protección contra clickjacking para browsers que no entienden CSP
  # frame-ancestors 'none' en el CSP hace lo mismo para browsers modernos
  X-Frame-Options: DENY

  # Envía solo el origen (sin path) en requests cross-origin HTTPS→HTTPS
  # y nada en cross-origin HTTPS→HTTP
  Referrer-Policy: strict-origin-when-cross-origin

  # Deshabilita APIs del browser que Piedrazul no necesita
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

  # Content Security Policy
  # default-src 'self'             — fallback para recursos no especificados
  # script-src 'self'              — sin unsafe-inline: Angular 19 application builder
  #                                  genera chunks con hash, no inline scripts.
  #                                  silent-check-sso.html usa script externo por esto
  # style-src 'unsafe-inline'      — Angular Material inyecta estilos inline en runtime
  #                                  (overlays, ripple, theming). Sin esto la UI se rompe
  # style-src fonts.googleapis.com — CSS de Google Fonts declarado en index.html
  # font-src fonts.gstatic.com     — archivos .woff2 servidos desde gstatic, no googleapis
  # img-src data:                  — Angular Material usa SVGs como data URIs en algunos casos
  # connect-src                    — fetch al backend y llamadas OIDC de Keycloak
  #                                  (token endpoint, userinfo, JWKS)
  # frame-src 'self'               — keycloak-js crea un iframe hacia silent-check-sso.html
  #                                  en el mismo origen para el silent SSO
  # frame-ancestors 'none'         — nadie puede embeber Piedrazul en un iframe,
  #                                  ni siquiera desde el mismo origen. Sistema médico,
  #                                  no hay razón para permitirlo
  # object-src 'none'              — bloquea plugins obsoletos (Flash, Java applets)
  # base-uri 'self'                — previene base tag injection
  # form-action 'self'             — restringe envío de formularios al mismo origen
  # upgrade-insecure-requests      — safety net: convierte HTTP→HTTPS automáticamente
  #                                  antes de la request, evita mixed content accidental
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://api.piedrazul.org https://auth.piedrazul.org; frame-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests
