PROJECT_NAME=piedrazul

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app_db
DB_USER=piedrazul
DB_PASSWORD=piedrazul
DB_SCHEMA=piedrazul

# JPA
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

# Server
SERVER_PORT=8080

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Keycloak DB
KC_DB_USERNAME=keycloak_user
KC_DB_PASSWORD=keycloak_pass
KC_DB_SCHEMA=keycloak

# Keycloak Admin
